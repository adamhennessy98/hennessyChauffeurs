---
export interface Props {
  title: string;
  description: string;
  imageUrl: string;
  imageAlt: string;
  linkUrl: string;
}

const { title, description, imageUrl, imageAlt, linkUrl } = Astro.props;
---

<div class="bg-mint border border-lavender/30 rounded-lg p-6 text-center h-96 flex flex-col hover:shadow-lg hover:border-lavender/50 transition-all duration-300">
  <div class="h-48 rounded-lg mb-4 overflow-hidden">
    <img src={imageUrl} alt={imageAlt} class="w-full h-full object-cover" />
  </div>
  <h3 class="font-display text-xl font-semibold mb-2 text-navy">{title}</h3>
  <p class="text-navy/80 mb-4 flex-grow">{description}</p>
  <a href={linkUrl} class="bg-navy text-mint px-6 py-2.5 rounded-lg font-medium hover:bg-teal transition-colors duration-200">
    Learn more
  </a>
</div>
