---
// You can add props here later
---

<header class="sticky top-0 z-50 bg-navy backdrop-blur border-b border-lavender/20">
  <div class="max-w-6xl mx-auto px-4 flex h-16 items-center justify-between">
    <!-- Logo / Name -->
    <a href="/" class="font-display font-semibold tracking-wide text-lg text-mint">Hennessy Chauffeurs</a>

    <!-- Nav links -->
    <nav class="hidden md:flex gap-8 text-sm font-medium" id="main-nav">
      <a href="/" class="text-mint/90 hover:text-gold transition-colors duration-200" data-page-index="0">Home</a>
      <a href="/airportTransfers" class="text-mint/90 hover:text-gold transition-colors duration-200" data-page-index="1">Airport Transfers</a>
      <a href="/businessTravel" class="text-mint/90 hover:text-gold transition-colors duration-200" data-page-index="2">Business Travel</a>
      <a href="/specialOccasions" class="text-mint/90 hover:text-gold transition-colors duration-200" data-page-index="3">Special Occasions</a>
      <a href="/blog" class="text-mint/90 hover:text-gold transition-colors duration-200" data-page-index="4">Blog</a>
    </nav>

    <!-- CTA -->
    <div class="flex items-center gap-3">
      <a href="/aboutMe" class="hidden sm:inline text-sm text-mint/90 hover:text-gold transition-colors duration-200">About me</a>
      <a href="/contact" class="rounded-lg px-4 py-2 bg-gold text-navy font-medium hover:bg-gold/90 transition-colors duration-200 text-sm">Contact me</a>
    </div>
  </div>
</header>

<script>
  // Page order mapping for slide direction detection
  const pageOrder = {
    '/': 0,
    '/airportTransfers': 1,
    '/businessTravel': 2,
    '/specialOccasions': 3,
    '/blog': 4,
    '/aboutMe': 5,
    '/contact': 6
  };

  let currentPageIndex = pageOrder[window.location.pathname] || 0;

  // Function to determine slide direction
  function getSlideDirection(fromIndex, toIndex) {
    return fromIndex > toIndex ? 'left' : 'right';
  }

  // Add click handlers to navigation links
  document.addEventListener('DOMContentLoaded', function() {
    const navLinks = document.querySelectorAll('#main-nav a[data-page-index]');
    
    navLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        const targetIndex = parseInt(this.getAttribute('data-page-index'));
        const direction = getSlideDirection(currentPageIndex, targetIndex);
        
        // Store direction for the transition
        document.documentElement.setAttribute('data-slide-direction', direction);
        
        // Update current page index
        currentPageIndex = targetIndex;
      });
    });
  });

  // Handle browser back/forward navigation
  window.addEventListener('popstate', function() {
    const newPageIndex = pageOrder[window.location.pathname] || 0;
    const direction = getSlideDirection(currentPageIndex, newPageIndex);
    
    document.documentElement.setAttribute('data-slide-direction', direction);
    currentPageIndex = newPageIndex;
  });

  // Listen for Astro's view transition events
  document.addEventListener('astro:before-preparation', function() {
    const direction = document.documentElement.getAttribute('data-slide-direction') || 'right';
    
    // Apply direction-specific CSS
    if (direction === 'left') {
      document.documentElement.style.setProperty('--slide-out-transform', 'translateX(30px)');
      document.documentElement.style.setProperty('--slide-in-transform', 'translateX(-30px)');
    } else {
      document.documentElement.style.setProperty('--slide-out-transform', 'translateX(-30px)');
      document.documentElement.style.setProperty('--slide-in-transform', 'translateX(30px)');
    }
  });
</script>

<style>
  /* Enhanced transitions with CSS variables */
  :root {
    --slide-out-transform: translateX(-30px);
    --slide-in-transform: translateX(30px);
  }
</style>
