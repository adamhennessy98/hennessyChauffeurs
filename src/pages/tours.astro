---
import BaseLayout from '../layouts/BaseLayout.astro';
const siteUrl = 'https://hennessychauffeurs.ie';
---

<BaseLayout
  title="Private Chauffeur Tours Ireland | Sightseeing & Day Trips | Hennessy Chauffeurs"
  description="Explore Ireland with a private chauffeur. Wild Atlantic Way, Ancient Ireland & custom tours. Luxury sightseeing day trips from Leinster with Hennessy Chauffeurs."
  breadcrumb={[{ name: 'Home', url: siteUrl }, { name: 'Tours' }]}
>
  <!-- Service JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Private Chauffeur Tours",
    "description": "Private chauffeur tours of Ireland. Wild Atlantic Way, Ancient Ireland heritage tours, Dublin city tours and custom sightseeing day trips from Leinster.",
    "url": `${siteUrl}/tours`,
    "provider": { "@id": siteUrl },
    "areaServed": { "@type": "Place", "name": "Leinster, Ireland" }
  })} />
  <!-- Hero Section with Background Image -->
  <div class="w-full h-80 md:h-105 lg:h-126 overflow-hidden relative">
    <img src="/countrySide.webp" alt="Irish countryside scenery on a chauffeur tour - Hennessy Chauffeurs" class="w-full h-full object-cover filter brightness-90 contrast-110 blur-sm" />
    <div class="absolute inset-0 bg-navy/40" />
    <div class="absolute inset-0 bg-gradient-to-b from-navy/20 via-transparent to-navy/30" />
    
    <!-- Hero Text Overlay -->
    <div class="absolute inset-0 flex items-center justify-center">
      <div class="text-center px-4 max-w-4xl mx-auto">
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 drop-shadow-2xl tracking-wide">
          Discover Ireland with Our Premium Tours
        </h1>
        <p class="text-lg md:text-xl text-mint leading-relaxed drop-shadow-lg">
          Explore the breathtaking beauty and rich heritage of Ireland with Hennessy Chauffeurs' exclusive tour services. 
          From the rolling green hills of the countryside to historic castles and vibrant cities, we offer carefully curated 
          tours that showcase the very best of what Ireland has to offer.
        </p>
      </div>
    </div>
  </div>

  <!-- Tours Page Content -->
  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="space-y-8">
      <!-- Tour 1: Wild Atlantic Way -->
      <div class="bg-mint/30 border border-lavender/30 rounded-lg p-8 hover:shadow-lg hover:border-lavender/50 transition-all duration-300">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between">
          <div class="flex-1">
            <h2 class="text-2xl font-bold text-navy mb-3 tracking-wide">Wild Atlantic Way Coastal Tour</h2>
            <p class="text-navy/80 mb-4">
              Experience Ireland's dramatic western coastline with stunning cliffs, pristine beaches, and charming coastal villages. 
              This full-day tour includes stops at the Cliffs of Moher, Dingle Peninsula, and traditional Irish fishing villages.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="bg-teal/20 text-teal px-3 py-1 rounded-full text-sm">8-10 hours</span>
              <span class="bg-gold/20 text-navy px-3 py-1 rounded-full text-sm">Scenic Routes</span>
              <span class="bg-lavender/30 text-navy px-3 py-1 rounded-full text-sm">Photo Stops</span>
            </div>
          </div>
          <div class="mt-4 md:mt-0 md:ml-8 flex flex-col gap-3">
            <a href="/contact" class="border-2 border-teal text-teal font-medium px-8 py-2 rounded-lg hover:bg-mint transition-colors duration-200 text-center">
              More Info
            </a>
            <a href="/contact" class="bg-gold text-navy font-medium px-8 py-3 rounded-lg hover:bg-gold/90 transition-colors duration-200 text-center">
              Book This Tour
            </a>
          </div>
        </div>
      </div>

      <!-- Tour 2: Ancient Ireland -->
      <div class="bg-mint/30 border border-lavender/30 rounded-lg p-8 hover:shadow-lg hover:border-lavender/50 transition-all duration-300">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between">
          <div class="flex-1">
            <h2 class="text-2xl font-bold text-navy mb-3 tracking-wide">Ancient Ireland Heritage Tour</h2>
            <p class="text-navy/80 mb-4">
              Journey through Ireland's rich history with visits to ancient castles, megalithic tombs, and medieval monasteries. 
              Discover Newgrange, Kilkenny Castle, and the Rock of Cashel with expert commentary on Irish heritage.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="bg-teal/20 text-teal px-3 py-1 rounded-full text-sm">6-8 hours</span>
              <span class="bg-gold/20 text-navy px-3 py-1 rounded-full text-sm">Historical Sites</span>
              <span class="bg-lavender/30 text-navy px-3 py-1 rounded-full text-sm">Castle Visits</span>
            </div>
          </div>
          <div class="mt-4 md:mt-0 md:ml-8 flex flex-col gap-3">
            <a href="/contact" class="border-2 border-teal text-teal font-medium px-8 py-2 rounded-lg hover:bg-mint transition-colors duration-200 text-center">
              More Info
            </a>
            <a href="/contact" class="bg-gold text-navy font-medium px-8 py-3 rounded-lg hover:bg-gold/90 transition-colors duration-200 text-center">
              Book This Tour
            </a>
          </div>
        </div>
      </div>

      <!-- Tour 3: Dublin Highlights -->
      <div class="bg-mint/30 border border-lavender/30 rounded-lg p-8 hover:shadow-lg hover:border-lavender/50 transition-all duration-300">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between">
          <div class="flex-1">
            <h2 class="text-2xl font-bold text-navy mb-3 tracking-wide">Dublin City & Surroundings Tour</h2>
            <p class="text-navy/80 mb-4">
              Explore Ireland's vibrant capital and its beautiful surroundings. Visit Trinity College, Dublin Castle, 
              Temple Bar, and venture to the scenic Wicklow Mountains known as the "Garden of Ireland."
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="bg-teal/20 text-teal px-3 py-1 rounded-full text-sm">5-7 hours</span>
              <span class="bg-gold/20 text-navy px-3 py-1 rounded-full text-sm">City Highlights</span>
              <span class="bg-lavender/30 text-navy px-3 py-1 rounded-full text-sm">Mountain Views</span>
            </div>
          </div>
          <div class="mt-4 md:mt-0 md:ml-8 flex flex-col gap-3">
            <a href="/contact" class="border-2 border-teal text-teal font-medium px-8 py-2 rounded-lg hover:bg-mint transition-colors duration-200 text-center">
              More Info
            </a>
            <a href="/contact" class="bg-gold text-navy font-medium px-8 py-3 rounded-lg hover:bg-gold/90 transition-colors duration-200 text-center">
              Book This Tour
            </a>
          </div>
        </div>
      </div>

      <!-- Custom Tour Option -->
      <div class="bg-mint/20 border-2 border-dashed border-lavender rounded-lg p-8 hover:border-gold/50 transition-all duration-300">
        <div class="text-center">
          <div class="w-16 h-16 bg-navy rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="text-gold text-2xl">✨</span>
          </div>
          <h2 class="text-2xl font-bold text-navy mb-4 tracking-wide">Create Your Custom Tour</h2>
          <p class="text-navy/80 mb-6 max-w-2xl mx-auto">
            Have specific places you'd like to visit? Want to explore your family heritage or follow a particular interest? 
            Let us design a completely personalized tour experience just for you. Share your ideas with us and we'll create 
            an itinerary that perfectly matches your preferences, schedule, and budget.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="mailto:info@hennessychauffeurs.ie?subject=Custom Tour Request" class="bg-gold text-navy font-medium px-8 py-3 rounded-lg hover:bg-gold/90 transition-colors duration-200">
              Email Tour Request
            </a>
            <a href="/contact" class="border-2 border-teal text-teal font-medium px-8 py-3 rounded-lg hover:bg-mint transition-colors duration-200">
              Contact Us
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>