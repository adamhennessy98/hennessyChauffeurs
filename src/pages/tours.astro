---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingNav from '../components/LandingNav.astro';
import LandingFooter from '../components/LandingFooter.astro';
import { SITE_URL, SITE_EMAIL } from '../config/site.ts';
import { tourValueProps, signatureTours, scenicImg } from '../data/tours.ts';

const siteUrl = SITE_URL;

function contactHref(tourId: string, intent: 'enquire' | 'book') {
  const tour = signatureTours.find((t) => t.id === tourId);
  const subject = encodeURIComponent(
    intent === 'book' ? `Book: ${tour?.title ?? 'Private tour'}` : `Enquiry: ${tour?.title ?? 'Private tour'}`,
  );
  return `/contact?subject=${subject}`;
}
---

<BaseLayout
  title="Private Chauffeur Tours Ireland | Sightseeing & Day Trips | Hennessy Chauffeurs"
  description="Explore Ireland with a private chauffeur-driver guide. Wild Atlantic Way, heritage sites, Dublin & Wicklow, Northern Ireland, and bespoke ancestry tours — one dedicated driver for your whole journey."
  breadcrumb={[{ name: 'Home', url: siteUrl }, { name: 'Tours' }]}
  showSiteChrome={false}
  bodyClass="bg-background text-on-surface font-body antialiased selection:bg-primary-container selection:text-on-primary-container"
  ogImage="/images/og-tours.webp"
>
  <LandingNav />

  <article class="bg-black text-on-surface">
    <!-- Hero -->
    <header class="relative min-h-[88vh] w-full overflow-hidden">
      <Image
        src={scenicImg}
        alt="Irish countryside and rolling hills — private chauffeur touring with Hennessy Chauffeurs."
        class="absolute inset-0 h-full w-full object-cover object-center"
        widths={[960, 1440, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-[#2D3047]/50" />
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/45 to-black/20" />

      <div class="relative z-10 mx-auto flex min-h-[88vh] max-w-7xl flex-col justify-end px-6 pb-16 pt-32 md:px-8 md:pb-24 md:pt-36">
        <p class="mb-4 font-label text-xs font-medium uppercase tracking-[0.35em] text-primary/90">
          Private chauffeur tours
        </p>
        <h1 class="mb-8 max-w-4xl font-display text-4xl font-normal leading-[1.08] tracking-tight text-on-surface sm:text-5xl md:text-6xl lg:text-7xl">
          Your Ireland, at your own pace.
        </h1>
        <p class="max-w-2xl font-body text-base leading-relaxed text-on-surface-variant sm:text-lg">
          One dedicated driver-guide for your entire journey — learning your interests, setting the rhythm, and sharing the Ireland only a local knows. Discreet, unhurried, and entirely yours.
        </p>
      </div>
    </header>

    <!-- Service JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: 'Private Chauffeur Tours',
      description: 'Private chauffeur tours of Ireland with one dedicated driver-guide. Wild Atlantic Way, heritage, Dublin, Northern Ireland, ancestry, and custom itineraries.',
      url: `${siteUrl}/tours`,
      provider: { '@id': siteUrl },
      areaServed: { '@type': 'Place', name: 'Ireland' },
    })} />

    <!-- Why a private chauffeur tour -->
    <section class="border-t border-white/5 bg-surface-container-low py-20 md:py-28" aria-labelledby="why-tours-heading">
      <div class="mx-auto max-w-7xl px-6 md:px-8">
        <header class="mx-auto mb-14 max-w-3xl text-center md:mb-16">
          <p class="mb-3 font-label text-xs font-medium uppercase tracking-[0.35em] text-on-surface-variant">
            Why travel this way
          </p>
          <h2 id="why-tours-heading" class="mb-5 font-display text-3xl font-normal tracking-tight text-on-surface md:text-4xl lg:text-5xl">
            Why a private chauffeur tour
          </h2>
          <p class="font-body leading-relaxed text-on-surface-variant">
            A tour should feel like an invitation, not a timetable. These are the reasons our guests choose a single chauffeur over a coach or rental car.
          </p>
        </header>

        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {tourValueProps.map((item) => (
            <article class="rounded-sm border border-white/10 bg-[#111] p-8">
              <span class="material-symbols-outlined text-4xl text-primary" aria-hidden="true">{item.icon}</span>
              <h3 class="mb-4 mt-5 font-display text-xl leading-snug text-on-surface">{item.title}</h3>
              <p class="text-sm leading-relaxed text-on-surface-variant">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Signature tours -->
    <section class="border-t border-white/5 px-6 py-20 md:px-8 md:py-28" aria-labelledby="signature-tours-heading">
      <div class="mx-auto max-w-7xl">
        <header class="mx-auto mb-14 max-w-3xl text-center md:mb-16">
          <p class="mb-3 font-label text-xs font-medium uppercase tracking-[0.35em] text-on-surface-variant">
            Curated starting points
          </p>
          <h2 id="signature-tours-heading" class="mb-5 font-display text-3xl font-normal tracking-tight text-on-surface md:text-4xl lg:text-5xl">
            Signature tours
          </h2>
          <p class="font-body leading-relaxed text-on-surface-variant">
            Every route below is a template — we refine timing, stops, and pace around you. No fixed departures, no shared groups.
          </p>
        </header>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
          {signatureTours.map((tour) => (
            <article class="flex flex-col overflow-hidden rounded-sm border border-white/10 bg-[#0f0f0f]">
              <div class="relative aspect-[16/10] overflow-hidden">
                <Image
                  src={tour.image}
                  alt={tour.imageAlt}
                  class="h-full w-full object-cover"
                  widths={[400, 640, 800]}
                  sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 33vw"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
              </div>

              <div class="flex flex-1 flex-col p-6 md:p-7">
                <h3 class="mb-3 font-display text-xl text-on-surface md:text-2xl">{tour.title}</h3>
                <p class="mb-5 flex-1 text-sm leading-relaxed text-on-surface-variant">{tour.description}</p>

                <div class="mb-6 flex flex-wrap gap-2">
                  <span class="rounded-sm border border-white/10 bg-[#141414] px-3 py-1 font-label text-xs uppercase tracking-wider text-on-surface-variant">
                    {tour.duration}
                  </span>
                  <span class="rounded-sm border border-primary/20 bg-primary/10 px-3 py-1 font-label text-xs uppercase tracking-wider text-primary">
                    {tour.type}
                  </span>
                </div>

                <div class="flex flex-col gap-3 sm:flex-row">
                  <a
                    href={contactHref(tour.id, 'enquire')}
                    class="inline-flex flex-1 items-center justify-center rounded-sm border border-on-surface-variant/40 px-4 py-3 font-label text-xs font-semibold uppercase tracking-[0.12em] text-on-surface transition-colors hover:border-on-surface hover:bg-white/5"
                  >
                    Enquire
                  </a>
                  <a
                    href={contactHref(tour.id, 'book')}
                    class="metallic-gradient inline-flex flex-1 items-center justify-center rounded-sm px-4 py-3 font-label text-xs font-semibold uppercase tracking-[0.12em] text-on-primary transition-opacity hover:opacity-90"
                  >
                    Book this tour
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Multi-day touring -->
    <section class="border-t border-white/5 bg-[#2D3047]/30" aria-labelledby="multi-day-heading">
      <div class="mx-auto flex max-w-7xl flex-col items-start gap-6 px-6 py-14 md:flex-row md:items-center md:gap-10 md:px-8 md:py-16">
        <span class="material-symbols-outlined shrink-0 text-4xl text-primary" aria-hidden="true">calendar_month</span>
        <div class="flex-1">
          <h2 id="multi-day-heading" class="mb-3 font-display text-2xl text-on-surface md:text-3xl">
            Multi-day touring
          </h2>
          <p class="max-w-3xl font-body leading-relaxed text-on-surface-variant">
            Bespoke two-day to multi-day itineraries are available on request — the same dedicated chauffeur throughout, with accommodation recommendations arranged to suit your style and budget. Tell us how long you have, and we will map the rest.
          </p>
        </div>
        <a
          href="/contact?subject=Multi-day%20tour%20enquiry"
          class="shrink-0 rounded-sm border border-on-surface-variant/40 px-6 py-3.5 font-label text-sm font-semibold uppercase tracking-[0.15em] text-on-surface transition-colors hover:border-on-surface hover:bg-white/5"
        >
          Discuss multi-day
        </a>
      </div>
    </section>

    <!-- Custom tour CTA -->
    <section class="border-t border-white/5 px-6 py-20 md:px-8 md:py-28" aria-labelledby="custom-tour-heading">
      <div class="mx-auto max-w-4xl rounded-sm border border-dashed border-white/15 bg-[#0a0a0a] px-8 py-14 text-center md:px-12 md:py-16">
        <span class="material-symbols-outlined mb-6 text-5xl text-primary" aria-hidden="true">route</span>
        <h2 id="custom-tour-heading" class="mb-5 font-display text-3xl font-normal tracking-tight text-on-surface md:text-4xl">
          Design your own itinerary
        </h2>
        <p class="mx-auto mb-10 max-w-2xl font-body leading-relaxed text-on-surface-variant">
          Have specific places in mind, family records to follow, or another passion — gardens, literature, whiskey, and more? Share your ideas and we will craft a completely personal route with no fixed template and no strangers in the car.
        </p>
        <div class="flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-5">
          <a
            href={`mailto:${SITE_EMAIL}?subject=Custom%20tour%20request`}
            class="metallic-gradient w-full rounded-sm px-8 py-4 font-label text-sm font-semibold uppercase tracking-[0.12em] text-on-primary transition-opacity hover:opacity-90 sm:w-auto sm:min-w-[240px]"
          >
            Email tour request
          </a>
          <a
            href="/contact?subject=Custom%20tour%20itinerary"
            class="w-full rounded-sm border border-on-surface-variant/40 px-8 py-4 font-label text-sm font-semibold uppercase tracking-[0.12em] text-on-surface transition-colors hover:border-on-surface hover:bg-white/5 sm:w-auto sm:min-w-[240px]"
          >
            Start on the contact form
          </a>
        </div>
      </div>
    </section>
  </article>

  <LandingFooter />
</BaseLayout>
