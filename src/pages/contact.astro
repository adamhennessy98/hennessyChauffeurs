---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingNav from '../components/LandingNav.astro';
import LandingFooter from '../components/LandingFooter.astro';
import { SITE_URL, SITE_EMAIL } from '../config/site.ts';

const siteUrl = SITE_URL;
---

<BaseLayout
  title="Reservation & Inquiry | Hennessy Chauffeurs"
  description="Book a chauffeur or send an inquiry. Hennessy Chauffeurs — airport transfers, executive travel, and bespoke tours across Dublin and Leinster."
  breadcrumb={[{ name: 'Home', url: siteUrl }, { name: 'Contact' }]}
  showSiteChrome={false}
  bodyClass="bg-black text-on-surface font-body antialiased selection:bg-primary-container selection:text-on-primary-container"
  ogImage="/images/og-contact.webp"
>
  <LandingNav />

  <article class="bg-black text-on-surface">
    <!-- Hero -->
    <header class="mx-auto max-w-7xl px-6 pb-12 pt-28 md:px-8 md:pb-16 md:pt-32">
      <div class="flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
        <div class="max-w-3xl">
          <p class="mb-4 font-label text-xs font-medium uppercase tracking-[0.35em] text-on-surface-variant">
            Secure your journey
          </p>
          <h1 class="font-display text-4xl font-normal leading-[1.08] tracking-tight text-on-surface sm:text-5xl md:text-6xl lg:text-7xl">
            Reservation &amp; inquiry.
          </h1>
        </div>
        <p class="max-w-md font-body text-base leading-relaxed text-on-surface-variant lg:max-w-lg lg:pb-2 lg:text-right">
          Experience the pinnacle of Irish hospitality. Our silent concierge service ensures every detail of your transport is managed with absolute precision.
        </p>
      </div>
    </header>

    <!-- Main: HQ + form -->
    <section class="border-t border-white/5 px-6 py-12 md:px-8 md:py-16" aria-labelledby="booking-form-heading">
      <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-12 lg:gap-16">
        <!-- Left: headquarters -->
        <div class="flex flex-col gap-10 lg:col-span-5">
          <div>
            <h2 id="booking-form-heading" class="sr-only">Booking and contact</h2>
            <p class="mb-6 font-label text-xs font-medium uppercase tracking-[0.3em] text-on-surface-variant">Headquarters</p>
            <ul class="space-y-6 font-body text-on-surface-variant">
              <li class="flex gap-4">
                <span class="material-symbols-outlined shrink-0 text-primary" aria-hidden="true">location_on</span>
                <div>
                  <p class="text-sm uppercase tracking-wider text-on-surface">Service area</p>
                  <p class="mt-1 leading-relaxed">Dublin &amp; Leinster, Ireland</p>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="material-symbols-outlined shrink-0 text-primary" aria-hidden="true">call</span>
                <div>
                  <p class="text-sm uppercase tracking-wider text-on-surface">24/7 dispatch</p>
                  <a href="tel:+353851315392" class="mt-1 block text-on-surface-variant transition-colors hover:text-on-surface">+353 85 131 5392</a>
                </div>
              </li>
              <li class="flex gap-4">
                <span class="material-symbols-outlined shrink-0 text-primary" aria-hidden="true">mail</span>
                <div>
                  <p class="text-sm uppercase tracking-wider text-on-surface">Concierge</p>
                  <a
                    href="mailto:info@hennessychauffeurs.ie"
                    class="mt-1 block text-on-surface-variant transition-colors hover:text-on-surface"
                  >
                    info@hennessychauffeurs.ie
                  </a>
                  <p class="mt-1 text-xs text-on-surface-variant/80">We aim to respond within 24 hours.</p>
                </div>
              </li>
            </ul>
          </div>

          <div>
            <p class="mb-4 font-label text-xs font-medium uppercase tracking-[0.3em] text-on-surface-variant">Connect</p>
            <div class="flex gap-3">
              <a
                href="tel:+353851315392"
                class="flex h-11 w-11 items-center justify-center rounded-sm border border-white/15 text-on-surface transition-colors hover:border-primary/40 hover:bg-white/5"
                aria-label="Call Hennessy Chauffeurs"
              >
                <span class="material-symbols-outlined text-xl">call</span>
              </a>
              <a
                href="mailto:info@hennessychauffeurs.ie"
                class="flex h-11 w-11 items-center justify-center rounded-sm border border-white/15 text-on-surface transition-colors hover:border-primary/40 hover:bg-white/5"
                aria-label="Email Hennessy Chauffeurs"
              >
                <span class="material-symbols-outlined text-xl">mail</span>
              </a>
            </div>
          </div>

          <!-- Stylised map -->
          <div class="relative mt-2 aspect-[4/3] w-full overflow-hidden rounded-sm border border-white/10 bg-[#0a0a0a]">
            <div
              class="absolute inset-0 opacity-[0.35]"
              style="background-image: linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px); background-size: 28px 28px;"
              aria-hidden="true"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-black/40" aria-hidden="true" />
            <div class="absolute left-1/2 top-1/2 flex -translate-x-1/2 -translate-y-1/2 flex-col items-center">
              <span class="material-symbols-outlined text-4xl text-primary drop-shadow-lg">location_on</span>
            </div>
            <div class="absolute bottom-4 left-4 rounded-sm border border-white/15 bg-black/75 px-3 py-2 backdrop-blur-sm">
              <p class="font-label text-[10px] font-semibold uppercase tracking-[0.25em] text-on-surface">Operational base</p>
              <p class="mt-0.5 text-xs text-on-surface-variant">Leinster · Ireland</p>
            </div>
          </div>
        </div>

        <!-- Right: form (Formspree — unchanged behaviour) -->
        <div class="lg:col-span-7">
          <div class="rounded-sm border border-white/10 bg-[#0f0f0f] p-6 md:p-10">
            <form action="https://formspree.io/f/xovpnnoj" method="POST" class="space-y-5">
              <input type="hidden" name="_subject" value="New booking request – Hennessy Chauffeurs" />
              <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
              <input type="hidden" name="_next" value={`${siteUrl}/thank-you`} />

              <div class="grid gap-5 md:grid-cols-2">
                <div class="md:col-span-1">
                  <label for="name" class="mb-2 block font-label text-xs font-medium uppercase tracking-wider text-on-surface-variant">Client name</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    autocomplete="name"
                    placeholder="Your name"
                    class="w-full rounded-sm border border-white/15 bg-[#141414] px-4 py-3 font-body text-sm text-on-surface placeholder:text-on-surface-variant/50 focus:border-primary/50 focus:outline-none focus:ring-1 focus:ring-primary/30"
                  />
                </div>
                <div class="md:col-span-1">
                  <label for="email" class="mb-2 block font-label text-xs font-medium uppercase tracking-wider text-on-surface-variant">Email address</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    autocomplete="email"
                    placeholder="you@example.com"
                    class="w-full rounded-sm border border-white/15 bg-[#141414] px-4 py-3 font-body text-sm text-on-surface placeholder:text-on-surface-variant/50 focus:border-primary/50 focus:outline-none focus:ring-1 focus:ring-primary/30"
                  />
                </div>
              </div>

              <div>
                <label for="phone" class="mb-2 block font-label text-xs font-medium uppercase tracking-wider text-on-surface-variant">Phone <span class="font-normal normal-case text-on-surface-variant/70">(optional)</span></label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  autocomplete="tel"
                  placeholder="+353 …"
                  class="w-full rounded-sm border border-white/15 bg-[#141414] px-4 py-3 font-body text-sm text-on-surface placeholder:text-on-surface-variant/50 focus:border-primary/50 focus:outline-none focus:ring-1 focus:ring-primary/30"
                />
              </div>

              <div class="grid gap-5 md:grid-cols-2">
                <div>
                  <label for="date" class="mb-2 block font-label text-xs font-medium uppercase tracking-wider text-on-surface-variant">Pickup date</label>
                  <div class="relative">
                    <input
                      type="date"
                      id="date"
                      name="date"
                      class="w-full rounded-sm border border-white/15 bg-[#141414] px-4 py-3 pr-10 font-body text-sm text-on-surface focus:border-primary/50 focus:outline-none focus:ring-1 focus:ring-primary/30 [color-scheme:dark]"
                    />
                    <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant" aria-hidden="true">
                      <span class="material-symbols-outlined text-xl">calendar_month</span>
                    </span>
                  </div>
                </div>
                <div>
                  <label for="time" class="mb-2 block font-label text-xs font-medium uppercase tracking-wider text-on-surface-variant">Pickup time</label>
                  <input
                    type="time"
                    id="time"
                    name="time"
                    class="w-full rounded-sm border border-white/15 bg-[#141414] px-4 py-3 font-body text-sm text-on-surface focus:border-primary/50 focus:outline-none focus:ring-1 focus:ring-primary/30 [color-scheme:dark]"
                  />
                </div>
              </div>

              <div>
                <label for="service" class="mb-2 block font-label text-xs font-medium uppercase tracking-wider text-on-surface-variant">Service tier</label>
                <div class="relative">
                  <select
                    id="service"
                    name="service"
                    class="w-full appearance-none rounded-sm border border-white/15 bg-[#141414] px-4 py-3 font-body text-sm text-on-surface focus:border-primary/50 focus:outline-none focus:ring-1 focus:ring-primary/30"
                  >
                    <option value="">Select a service</option>
                    <option value="airport">Airport transfer</option>
                    <option value="business">Executive sedan / business travel</option>
                    <option value="occasions">Special occasions</option>
                    <option value="blog">Blog / editorial</option>
                    <option value="other">Other / bespoke</option>
                  </select>
                  <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant" aria-hidden="true">
                    <span class="material-symbols-outlined text-xl">expand_more</span>
                  </span>
                </div>
              </div>

              <div class="grid gap-5 md:grid-cols-2">
                <div>
                  <label for="from" class="mb-2 block font-label text-xs font-medium uppercase tracking-wider text-on-surface-variant">Pickup location</label>
                  <input
                    type="text"
                    id="from"
                    name="from"
                    placeholder="e.g. Dublin Airport (DUB)"
                    class="w-full rounded-sm border border-white/15 bg-[#141414] px-4 py-3 font-body text-sm text-on-surface placeholder:text-on-surface-variant/50 focus:border-primary/50 focus:outline-none focus:ring-1 focus:ring-primary/30"
                  />
                </div>
                <div>
                  <label for="to" class="mb-2 block font-label text-xs font-medium uppercase tracking-wider text-on-surface-variant">Destination</label>
                  <input
                    type="text"
                    id="to"
                    name="to"
                    placeholder="Hotel, venue, or address"
                    class="w-full rounded-sm border border-white/15 bg-[#141414] px-4 py-3 font-body text-sm text-on-surface placeholder:text-on-surface-variant/50 focus:border-primary/50 focus:outline-none focus:ring-1 focus:ring-primary/30"
                  />
                </div>
              </div>

              <div>
                <label for="notes" class="mb-2 block font-label text-xs font-medium uppercase tracking-wider text-on-surface-variant">Special requirements</label>
                <textarea
                  id="notes"
                  name="notes"
                  rows="4"
                  placeholder="Flight number, luggage count, child seats, or specific preferences…"
                  class="w-full resize-y rounded-sm border border-white/15 bg-[#141414] px-4 py-3 font-body text-sm leading-relaxed text-on-surface placeholder:text-on-surface-variant/50 focus:border-primary/50 focus:outline-none focus:ring-1 focus:ring-primary/30"
                ></textarea>
              </div>

              <div class="flex flex-col gap-4 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
                <p class="max-w-md font-body text-xs italic leading-relaxed text-on-surface-variant/90">
                  All inquiries are reviewed manually by our concierge team.
                </p>
                <button
                  type="submit"
                  class="metallic-gradient inline-flex shrink-0 items-center justify-center gap-2 rounded-sm px-8 py-3.5 font-label text-sm font-semibold uppercase tracking-[0.12em] text-on-primary transition-opacity hover:opacity-90"
                >
                  Request booking
                  <span class="material-symbols-outlined text-lg" aria-hidden="true">arrow_forward</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- Quote -->
    <section class="border-t border-white/5 px-6 py-20 md:px-8 md:py-24" aria-labelledby="mission-quote">
      <div class="mx-auto max-w-3xl text-center">
        <span class="material-symbols-outlined mb-6 text-5xl text-outline-variant/40" aria-hidden="true">format_quote</span>
        <blockquote id="mission-quote" class="font-display text-xl font-normal leading-relaxed text-on-surface md:text-2xl">
          Our mission is to provide more than just a ride; we provide the time and peace of mind necessary for you to focus on what truly matters.
        </blockquote>
        <p class="mt-8 font-label text-xs font-semibold uppercase tracking-[0.28em] text-on-surface-variant">
          Hennessy Chauffeurs
        </p>
      </div>
    </section>
  </article>

  <LandingFooter />
</BaseLayout>
