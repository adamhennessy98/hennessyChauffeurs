---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { services } from '../data/services.ts';

const benefits = [
  { icon: 'clock', text: 'Punctuality guaranteed — we track your schedule so you never miss a meeting or flight.' },
  { icon: 'shield', text: 'Discreet, confidential service for executives and high-profile clients.' },
  { icon: 'car', text: 'Premium, well-maintained vehicles for comfort and style every time.' },
  { icon: 'briefcase', text: 'Professional, experienced chauffeurs who know Leinster inside and out.' },
  { icon: 'availability', text: '24/7 availability — we\'re here for early flights and late-night returns.' },
  { icon: 'plane', text: 'Flight monitoring — we adjust pick-up times automatically if your flight is delayed.' },
  { icon: 'handshake', text: 'Meet & greet at arrivals with a name board — no searching for your driver.' },
  { icon: 'door', text: 'Door-to-door service from your address to your destination, hassle-free.' },
  { icon: 'check', text: 'Flexible booking with easy quotes and last-minute changes when you need them.' },
];
---

<BaseLayout
  title="Hennessy Chauffeurs | Premium Chauffeur Service in Leinster, Ireland"
  description="Hennessy Chauffeurs offers luxury chauffeur services across Leinster, Ireland. Airport transfers, executive business travel, wedding transport & guided tours. Book your journey today."
  breadcrumb={[{ name: 'Home' }]}
>
  <Hero 
    title="Premium Chauffeur Service"
    subtitle="Leinster"
    imageUrl="/stockPhoto1.webp"
    imageAlt="Luxury chauffeur vehicle parked outside Dublin Airport - Hennessy Chauffeurs"
  />

  <!-- Service Blurb -->
  <section class="max-w-4xl mx-auto px-4 py-16 text-center">
    <h1 class="text-3xl md:text-4xl font-bold text-navy mb-6 tracking-wide">
      Premium Chauffeur Service in Leinster
    </h1>
    <p class="text-lg md:text-xl text-navy/80 mb-8 leading-relaxed">
      Experience luxury travel with Hennessy Chauffeurs. We provide professional, 
      reliable, and discreet transportation services for business executives, special 
      occasions, and airport transfers. Our experienced drivers and premium fleet 
      ensure you arrive in comfort and style, every time.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/contact" class="inline-block bg-gold text-navy font-medium px-8 py-3 rounded-lg hover:bg-gold/90 transition-colors duration-200">
        Book Your Journey
      </a>
      <a href="tel:+353851315392" class="inline-block border-2 border-teal text-teal font-medium px-8 py-3 rounded-lg hover:bg-mint transition-colors duration-200">
        Call Now
      </a>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <header class="text-center mb-12">
      <h2 class="text-2xl md:text-3xl font-bold text-navy tracking-wide mb-3">Why Choose Hennessy Chauffeurs</h2>
      <p class="text-lg text-lavender max-w-2xl mx-auto">Professional, reliable, and tailored to how you travel.</p>
      <div class="w-16 h-0.5 bg-gold mx-auto mt-6" aria-hidden="true"></div>
    </header>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
      {benefits.map((item) => (
        <div class="flex gap-4 items-start">
          <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-teal/10 flex items-center justify-center text-teal" aria-hidden="true">
            {item.icon === 'clock' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            )}
            {item.icon === 'shield' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            )}
            {item.icon === 'car' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h8m-8 4h8m-5 8v-4a1 1 0 00-1-1h-4a1 1 0 00-1 1v4M7 7v6m10-6v6"/></svg>
            )}
            {item.icon === 'briefcase' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            )}
            {item.icon === 'availability' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            )}
            {item.icon === 'plane' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
            )}
            {item.icon === 'handshake' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v-1a1.5 1.5 0 013 0v1m0 0V11m0-5.5a1.5 1.5 0 013 0v3m0 0V11"/></svg>
            )}
            {item.icon === 'door' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            )}
            {item.icon === 'check' && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            )}
          </div>
          <p class="text-navy/90 leading-relaxed pt-0.5">{item.text}</p>
        </div>
      ))}
    </div>
    <div class="w-16 h-0.5 bg-lavender/40 mx-auto mt-12" aria-hidden="true"></div>
    <div class="text-center mt-8">
      <a href="/contact" class="inline-block bg-gold text-navy font-medium px-8 py-3 rounded-lg hover:bg-gold/90 transition-colors duration-200">
        Book Your Journey
      </a>
    </div>
  </section>

  <!-- Services Section -->
  <section class="bg-mint/30 py-16">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-8 text-navy tracking-wide">Our Services</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {services.map((service) => (
        <ServiceCard 
          title={service.title}
          description={service.description}
          imageUrl={service.imageUrl}
          imageAlt={service.imageAlt}
          linkUrl={service.linkUrl}
        />
      ))}
      </div>
    </div>
  </section>
  <script is:inline src="https://smartarget.online/loader.js?u=8891d79975d6ec6a9e1f1fd2d3369b754499b154"></script>
</BaseLayout>
