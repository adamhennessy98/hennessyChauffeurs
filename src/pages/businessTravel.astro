---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL } from '../config/site.ts';

const siteUrl = SITE_URL;
---

<BaseLayout
  title="Executive Business Travel Chauffeur | Corporate Transport Leinster | Hennessy Chauffeurs"
  description="Professional executive chauffeur service in Leinster from €40/hour. Corporate accounts, luxury vehicles, WiFi & punctual service for business meetings & events."
  breadcrumb={[{ name: 'Home', url: siteUrl }, { name: 'Business Travel' }]}
  ogImage="/images/og-business.webp"
>
  <!-- Service JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Business Travel",
    "description": "Executive transportation for business meetings. Corporate accounts, luxury vehicles, WiFi and punctual service across Leinster, Ireland.",
    "url": `${siteUrl}/businessTravel`,
    "provider": { "@id": siteUrl },
    "areaServed": { "@type": "Place", "name": "Leinster, Ireland" },
    "offers": {
      "@type": "Offer",
      "priceSpecification": { "@type": "UnitPriceSpecification", "priceCurrency": "EUR", "price": "40", "unitText": "HOUR" },
      "description": "From €40/hour"
    }
  })} />
  <!-- Business Travel Page Content -->
  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="text-center mb-12">
      <h1 class="text-3xl md:text-4xl font-bold text-navy mb-6 tracking-wide">
        Business Travel
      </h1>
      <p class="text-lg md:text-xl text-lavender">
        Executive transportation for business meetings
      </p>
    </div>

    <!-- Service Details -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <!-- Content -->
      <div>
        <h2 class="text-2xl font-semibold mb-6 text-navy">Professional Executive Transportation</h2>
        <p class="text-lg text-navy/90 leading-relaxed mb-6">
          Make the right impression with our premium business travel service. Perfect for 
          executives, corporate meetings, and professional events throughout Leinster.
        </p>
        
        <h3 class="text-xl font-semibold mb-4 text-navy">Business Travel Features:</h3>
        <ul class="space-y-3 mb-6">
          <li class="flex items-start">
            <span class="text-teal mr-2">✓</span>
            <span>Corporate accounts available</span>
          </li>
          <li class="flex items-start">
            <span class="text-teal mr-2">✓</span>
            <span>Executive luxury vehicles</span>
          </li>
          <li class="flex items-start">
            <span class="text-teal mr-2">✓</span>
            <span>Punctual and reliable service</span>
          </li>
          <li class="flex items-start">
            <span class="text-teal mr-2">✓</span>
            <span>WiFi available in vehicles</span>
          </li>
          <li class="flex items-start">
            <span class="text-teal mr-2">✓</span>
            <span>Complimentary newspaper service</span>
          </li>
        </ul>

        <div class="bg-mint/50 border border-lavender/30 p-6 rounded-lg mb-6">
          <h3 class="text-xl font-semibold mb-2 text-navy">From €40/hour</h3>
          <p class="text-lavender">Competitive hourly rates for business transportation</p>
        </div>

        <!-- Contact Button -->
        <div class="mt-8">
          <a href="/contact" class="inline-block rounded-lg px-12 py-3 bg-gold text-navy font-medium hover:bg-gold/90 transition-colors duration-200 text-sm">
            Book Business Travel
          </a>
        </div>
      </div>

      <!-- Image -->
      <div>
        <img src="/serviceImage2.webp" alt="Executive chauffeur car for business travel in Leinster - Hennessy Chauffeurs" class="w-full h-auto rounded-lg shadow-lg object-cover border border-lavender/30" />
      </div>
    </div>
  </section>
</BaseLayout>
