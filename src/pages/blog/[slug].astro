---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import LandingNav from '../../components/LandingNav.astro';
import LandingFooter from '../../components/LandingFooter.astro';
import { getEntry, getCollection, render } from 'astro:content';
import { SITE_URL } from '../../config/site.ts';

const siteUrl = SITE_URL;

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id } }));
}

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/blog');
}

const entry = await getEntry('posts', slug);
if (!entry) {
  return Astro.redirect('/blog');
}

const { Content } = await render(entry);
const { title, pubDate, description } = entry.data;
---

<BaseLayout
  title={`${title} | Hennessy Chauffeurs`}
  description={description ?? title}
  breadcrumb={[{ name: 'Home', url: siteUrl }, { name: 'Blog', url: `${siteUrl}/blog` }, { name: title }]}
  showSiteChrome={false}
  bodyClass="bg-black text-on-surface font-body antialiased selection:bg-primary-container selection:text-on-primary-container"
  ogImage="/images/og-blog.webp"
>
  <LandingNav />

  <article class="bg-black text-on-surface">
    <div class="mx-auto max-w-3xl px-6 pb-20 pt-24 md:px-8 md:pb-28 md:pt-28">
      <a
        href="/blog"
        class="mb-10 inline-flex items-center gap-2 font-label text-xs font-semibold uppercase tracking-[0.2em] text-on-surface-variant transition-colors hover:text-on-surface"
      >
        <span class="material-symbols-outlined text-lg" aria-hidden="true">arrow_back</span>
        Journal
      </a>

      <header class="border-b border-white/10 pb-10">
        <p class="mb-4 font-label text-xs font-medium uppercase tracking-[0.35em] text-on-surface-variant">Article</p>
        <h1 class="font-display text-3xl font-normal leading-tight tracking-tight text-on-surface sm:text-4xl md:text-5xl">
          {title}
        </h1>
        <time class="mt-6 block font-label text-sm uppercase tracking-wider text-on-surface-variant" datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString('en-IE', { dateStyle: 'long' })}
        </time>
        {description && <p class="mt-6 font-body text-lg leading-relaxed text-on-surface-variant">{description}</p>}
      </header>

      <div
        class="blog-content mt-12 space-y-6 font-body text-base leading-relaxed text-on-surface-variant [&_a]:text-primary [&_a]:underline [&_a]:underline-offset-2 hover:[&_a]:text-on-surface [&_blockquote]:border-l-2 [&_blockquote]:border-primary/40 [&_blockquote]:pl-6 [&_blockquote]:font-display [&_blockquote]:italic [&_blockquote]:text-on-surface [&_h2]:mt-12 [&_h2]:mb-4 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-normal [&_h2]:text-on-surface [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:font-display [&_h3]:text-xl [&_h3]:font-normal [&_h3]:text-on-surface [&_li]:marker:text-on-surface-variant/50 [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:pl-6 [&_p]:leading-relaxed [&_strong]:font-semibold [&_strong]:text-on-surface [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6"
      >
        <Content />
      </div>
    </div>
  </article>

  <LandingFooter />
</BaseLayout>
