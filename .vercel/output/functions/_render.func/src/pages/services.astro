---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingNav from '../components/LandingNav.astro';
import LandingFooter from '../components/LandingFooter.astro';

const siteUrl = 'https://hennessychauffeurs.ie';
---

<BaseLayout
  title="Chauffeur Services | Airport, Executive & Tours | Hennessy Chauffeurs"
  description="Meet and greet airport transfers, executive business travel, and bespoke private tours across Ireland. Discreet, punctual luxury chauffeur service."
  breadcrumb={[{ name: 'Home', url: siteUrl }, { name: 'Services' }]}
  showSiteChrome={false}
  bodyClass="bg-black text-on-surface font-body antialiased selection:bg-primary-container selection:text-on-primary-container"
  ogImage="/images/service-airport-terminal2.png"
>
  <LandingNav />

  <article class="bg-black text-on-surface">
    <!-- Hero -->
    <header class="mx-auto max-w-7xl px-6 pb-20 pt-28 md:px-8 md:pb-28 md:pt-32">
      <p class="mb-4 font-label text-xs font-medium uppercase tracking-[0.35em] text-on-surface-variant">
        Exceptional standards
      </p>
      <h1 class="mb-8 max-w-4xl font-display text-4xl font-normal leading-[1.1] tracking-tight text-on-surface sm:text-5xl md:text-6xl lg:text-7xl">
        Refined travel solutions
      </h1>
      <p class="max-w-2xl font-body text-base leading-relaxed text-on-surface-variant sm:text-lg">
        Luxury chauffeur services tailored for discerning passengers who value discretion, punctuality, and calm. From terminal to boardroom to coastline, every journey is composed with the same quiet precision.
      </p>
    </header>

    <!-- Airport transfers -->
    <section class="border-t border-white/5" aria-labelledby="airport-heading">
      <div class="mx-auto grid max-w-7xl gap-0 md:grid-cols-2 md:items-stretch">
        <div class="relative min-h-[320px] md:min-h-[480px]">
          <img
            src="/images/service-airport-terminal2.png"
            alt="Premium airport transfer — vehicle at terminal, evening light."
            class="absolute inset-0 h-full w-full object-cover"
            width="900"
            height="900"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent md:bg-gradient-to-r md:from-transparent md:via-black/30 md:to-black/80" />
        </div>
        <div class="flex flex-col justify-center bg-[#0a0a0a] px-6 py-16 md:px-12 md:py-20 lg:px-16">
          <h2 id="airport-heading" class="mb-6 font-display text-3xl font-normal tracking-tight text-on-surface md:text-4xl">
            Airport transfers
          </h2>
          <p class="mb-10 max-w-lg font-body leading-relaxed text-on-surface-variant">
            Meet and greet at Ireland&apos;s major aviation hubs. We track your flight, assist with luggage, and deliver a seamless transition from airside to your destination in Leinster and beyond.
          </p>
          <div class="mb-10 grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div class="border border-white/10 bg-[#141414] px-4 py-4">
              <p class="font-display text-lg text-on-surface">Dublin</p>
              <p class="mt-1 font-label text-xs uppercase tracking-wider text-on-surface-variant">DUB / EIDW</p>
            </div>
            <div class="border border-white/10 bg-[#141414] px-4 py-4">
              <p class="font-display text-lg text-on-surface">Cork</p>
              <p class="mt-1 font-label text-xs uppercase tracking-wider text-on-surface-variant">ORK / EICK</p>
            </div>
            <div class="border border-white/10 bg-[#141414] px-4 py-4">
              <p class="font-display text-lg text-on-surface">Shannon</p>
              <p class="mt-1 font-label text-xs uppercase tracking-wider text-on-surface-variant">SNN / EINN</p>
            </div>
          </div>
          <a
            href="/airportTransfers"
            class="inline-flex w-fit items-center gap-2 font-label text-sm font-semibold uppercase tracking-[0.2em] text-primary transition-opacity hover:opacity-80"
          >
            Explore the hubs
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Executive business -->
    <section class="border-t border-white/5" aria-labelledby="executive-heading">
      <div class="mx-auto grid max-w-7xl gap-0 md:grid-cols-2 md:items-stretch">
        <div class="order-2 flex flex-col justify-center bg-[#0a0a0a] px-6 py-16 md:order-1 md:px-12 md:py-20 lg:px-16">
          <h2 id="executive-heading" class="mb-6 font-display text-3xl font-normal tracking-tight text-on-surface md:text-4xl">
            Executive business travel
          </h2>
          <p class="mb-10 max-w-lg font-body leading-relaxed text-on-surface-variant">
            A composed cabin for calls, preparation, or rest between commitments. Punctuality and discretion are assumed — so you can focus on what matters before you arrive.
          </p>
          <ul class="space-y-6">
            <li class="flex gap-4">
              <span class="material-symbols-outlined mt-0.5 text-primary" aria-hidden="true">location_on</span>
              <div>
                <p class="font-display text-lg text-on-surface">Inter-city transfers</p>
                <p class="mt-1 text-sm leading-relaxed text-on-surface-variant">Direct, efficient travel between cities with a single dedicated driver.</p>
              </div>
            </li>
            <li class="flex gap-4">
              <span class="material-symbols-outlined mt-0.5 text-primary" aria-hidden="true">schedule</span>
              <div>
                <p class="font-display text-lg text-on-surface">Full day chauffeur</p>
                <p class="mt-1 text-sm leading-relaxed text-on-surface-variant">The vehicle and chauffeur at your disposal for multi-stop itineraries.</p>
              </div>
            </li>
          </ul>
          <a href="/businessTravel" class="mt-10 inline-flex w-fit font-label text-sm font-semibold uppercase tracking-[0.2em] text-primary underline-offset-4 hover:underline">
            Business travel details
          </a>
        </div>
        <div class="relative order-1 min-h-[320px] md:order-2 md:min-h-[480px]">
          <img
            src="/images/service-executive-docklands.png"
            alt="Rear passenger perspective of a luxury vehicle interior with ambient lighting."
            class="absolute inset-0 h-full w-full object-cover"
            width="1200"
            height="900"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-black/20" />
        </div>
      </div>
    </section>

    <!-- Bespoke tours -->
    <section class="border-t border-white/5 px-6 py-20 md:px-8 md:py-28" aria-labelledby="tours-heading">
      <div class="mx-auto max-w-7xl">
        <div class="mx-auto mb-14 max-w-3xl text-center md:mb-16">
          <h2 id="tours-heading" class="mb-5 font-display text-3xl font-normal tracking-tight text-on-surface md:text-4xl lg:text-5xl">
            Bespoke private tours
          </h2>
          <p class="font-body leading-relaxed text-on-surface-variant">
            Discover Ireland through an itinerary shaped around your pace and interests — coastline, mountains, heritage towns, or a single perfect day out from Dublin.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-3 md:grid-cols-12 md:grid-rows-2 md:gap-4 md:min-h-[560px]">
          <a
            href="/tours"
            class="group relative min-h-[220px] overflow-hidden rounded-sm bg-[#111] md:col-span-8 md:row-span-1 md:min-h-0"
          >
            <img
              src="/images/service-tours-countryside.png"
              alt="Coastal cliffs and Atlantic light — Wild Atlantic Way style scenery."
              class="absolute inset-0 h-full w-full object-cover opacity-90 transition-transform duration-700 group-hover:scale-105"
              width="1200"
              height="800"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent" />
            <div class="absolute bottom-0 left-0 p-6 md:p-8">
              <p class="font-label text-xs uppercase tracking-[0.25em] text-primary">Signature route</p>
              <p class="mt-2 font-display text-2xl text-on-surface md:text-3xl">Wild Atlantic Way</p>
            </div>
          </a>
          <a
            href="/tours"
            class="group relative min-h-[280px] overflow-hidden rounded-sm bg-[#111] md:col-span-4 md:row-span-2 md:min-h-0"
          >
            <img
              src="/images/hero-mercedes.png"
              alt="Elegant streetscape suggesting historic Dublin architecture."
              class="absolute inset-0 h-full w-full object-cover object-center opacity-85 transition-transform duration-700 group-hover:scale-105"
              width="1920"
              height="1080"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-transparent to-transparent" />
            <div class="absolute bottom-0 left-0 p-6 md:p-8">
              <p class="font-label text-xs uppercase tracking-[0.25em] text-primary">Urban heritage</p>
              <p class="mt-2 font-display text-2xl text-on-surface md:text-3xl">Historic Dublin</p>
            </div>
          </a>
          <a
            href="/tours"
            class="group relative min-h-[200px] overflow-hidden rounded-sm bg-[#111] md:col-span-8 md:row-span-1 md:min-h-0"
          >
            <img
              src="/luxury-chauffeur-service.png"
              alt="Rolling green hills — Wicklow and countryside touring."
              class="absolute inset-0 h-full w-full object-cover opacity-90 transition-transform duration-700 group-hover:scale-105"
              width="1200"
              height="800"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-transparent" />
            <div class="absolute bottom-0 left-0 p-6 md:p-8">
              <p class="font-label text-xs uppercase tracking-[0.25em] text-primary">Mountains &amp; lakes</p>
              <p class="mt-2 font-display text-2xl text-on-surface md:text-3xl">Wicklow Mountains</p>
            </div>
          </a>
        </div>

        <div class="mt-10 flex flex-col items-stretch justify-between gap-6 rounded-sm border border-white/10 bg-[#0a0a0a] p-8 md:flex-row md:items-center md:p-10">
          <div class="flex items-start gap-4">
            <span class="material-symbols-outlined text-primary" aria-hidden="true">map</span>
            <div>
              <p class="font-display text-xl text-on-surface">Create your own journey</p>
              <p class="mt-1 max-w-xl text-sm leading-relaxed text-on-surface-variant">
                Share dates, interests, and pace — we&apos;ll propose a route and vehicle plan tailored to you.
              </p>
            </div>
          </div>
          <a
            href="/contact"
            class="metallic-gradient shrink-0 rounded-sm px-8 py-3.5 text-center font-label text-sm font-semibold uppercase tracking-[0.15em] text-on-primary transition-opacity hover:opacity-90"
          >
            Plan now
          </a>
        </div>
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="border-t border-white/5 px-6 py-20 md:px-8 md:py-28">
      <div class="mx-auto max-w-4xl text-center">
        <p class="mb-10 font-display text-2xl leading-snug text-on-surface sm:text-3xl md:text-4xl">
          The journey is as important as the destination.
        </p>
        <div class="flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-5">
          <a
            href="/contact"
            class="metallic-gradient w-full rounded-sm px-8 py-4 font-label text-sm font-semibold uppercase tracking-[0.12em] text-on-primary transition-opacity hover:opacity-90 sm:w-auto sm:min-w-[240px]"
          >
            Secure your chauffeur
          </a>
          <a
            href="mailto:info@hennessychauffeurs.ie?subject=Brochure%20request"
            class="w-full rounded-sm border border-on-surface-variant/40 px-8 py-4 font-label text-sm font-semibold uppercase tracking-[0.12em] text-on-surface transition-colors hover:border-on-surface hover:bg-white/5 sm:w-auto sm:min-w-[240px]"
          >
            Download brochure
          </a>
        </div>
      </div>
    </section>
  </article>

  <LandingFooter />
</BaseLayout>
