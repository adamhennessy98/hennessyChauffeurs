# Create Post API (Make webhook) and GitHub integration
# Copy to .env and set in Vercel Environment Variables.

# Secret sent by Make with each request (e.g. Authorization: Bearer <value> or X-Webhook-Secret header)
CREATE_POST_SECRET=your-secret-here

# GitHub Personal Access Token with repo scope (to create/commit files)
GITHUB_TOKEN=ghp_xxxx

# Repo in form owner/repo (e.g. yourname/hennessy-chauffeurs)
GITHUB_REPO=yourname/hennessy-chauffeurs

# Optional: default branch for commits (defaults to "main")
# GITHUB_BRANCH=main
